@{
    var titulo = ViewBag.TituloPagina as string ?? ViewData["Title"]?.ToString() ?? "PSA Costa Rica";
    var rolActivo = ViewBag.RolActivo as string ?? "Dueno";
    var usuarioAutenticado = User?.Identity?.IsAuthenticated ?? false;
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var accionActual = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var esLandingInstitucional = string.Equals(controladorActual, "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(accionActual, "Index", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@titulo - PSA Costa Rica</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/global.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/componentes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/propietario.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ingeniero.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/administrador.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="aplicacion-shell">
    <div id="trobberGlobal" class="trobber-global d-none" aria-hidden="true">
        <div class="trobber-global__panel" role="status" aria-live="polite" aria-label="Cargando">
            <span class="spinner-border" aria-hidden="true"></span>
            <span>Cargando, por favor espere...</span>
        </div>
    </div>
    @if (usuarioAutenticado)
    {
        @await Html.PartialAsync("_Encabezado")
        <div class="contenedor-aplicacion">
            @await Html.PartialAsync("_BarraLateral")
            <main class="contenido-principal" role="main">
                @await Html.PartialAsync("_MigasPan")
                @await Html.PartialAsync("_MensajesSistema")
                @RenderBody()
            </main>
        </div>
        @await Html.PartialAsync("_PiePagina")
    }
    else
    {
        <main role="main">
            @await Html.PartialAsync("_MensajesSistema")
            @RenderBody()
        </main>

        @if (!esLandingInstitucional)
        {
            @await Html.PartialAsync("_PiePagina")
        }
    }

    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/utilidades.js" asp-append-version="true"></script>
    <script src="~/js/navegacion.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
