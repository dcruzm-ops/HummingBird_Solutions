@using System.Security.Claims
@{
    var nombreUsuario = User?.Identity?.Name;
    var nombreMostrar = string.IsNullOrWhiteSpace(nombreUsuario) ? "Usuario" : nombreUsuario;
    var rolClaim = User.FindFirstValue(ClaimTypes.Role);
    var rolActivo = rolClaim switch
    {
        "1" => "Administrador",
        "3" => "Ingeniero",
        _ => "Dueño"
    };
}
<header class="encabezado-principal" role="banner">
    <div class="encabezado-principal__izquierda">
        <button class="btn-menu" id="toggleSidebar" type="button" aria-label="Mostrar u ocultar menú">
            <span></span>
            <span></span>
            <span></span>
        </button>
        <div class="encabezado-principal__marca">
            <h1>PSA Costa Rica</h1>
            <p>Programa de Servicios Ambientales</p>
        </div>
    </div>

    <div class="encabezado-principal__derecha">
        <button class="btn btn-sm btn-outline-secondary" id="toggleTema" type="button">Cambiar tema</button>
        <div class="usuario-resumen" aria-label="Resumen de usuario">
            <div class="avatar">@nombreMostrar.Substring(0, 1).ToUpperInvariant()</div>
            <div>
                <strong>@nombreMostrar</strong>
                <small>@rolActivo</small>
            </div>
        </div>
    </div>
</header>
