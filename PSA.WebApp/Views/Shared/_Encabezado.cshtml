@using System.Security.Claims
@{
    var nombreUsuario = User?.Identity?.Name;
    var nombreMostrar = string.IsNullOrWhiteSpace(nombreUsuario) ? "Usuario" : nombreUsuario;
    var rolClaim = User.FindFirstValue(ClaimTypes.Role);
    var rolActivo = rolClaim switch
    {
        "1" => "Administrador",
        "3" => "Ingeniero",
        _ => "Dueño"
    };
}
<header class="encabezado-sistema" role="banner">
    <div class="encabezado-sistema__izquierda">
        <button class="boton-icono" id="botonMenuLateral" type="button" aria-label="Mostrar u ocultar menú">☰</button>
        <div>
            <h2 class="titulo-encabezado">PSA Costa Rica</h2>
            <p class="mb-0">Programa de Servicios Ambientales</p>
        </div>
    </div>

    <div class="encabezado-sistema__derecha">
        <button class="boton-secundario boton-sm" id="botonTema" type="button">Cambiar tema</button>
        <div class="bloque-usuario" aria-label="Resumen de usuario">
            <div class="avatar-usuario">@nombreMostrar.Substring(0, 1).ToUpperInvariant()</div>
            <div>
                <strong>@nombreMostrar</strong>
                <small class="d-block">@rolActivo</small>
            </div>
        </div>
    </div>
</header>
