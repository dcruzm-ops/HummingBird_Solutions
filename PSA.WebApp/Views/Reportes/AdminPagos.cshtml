@model PSA.WebApp.Models.ReporteAdminPagosViewModel
<section class="seccion-pagina"><h2>Pagos administrativos</h2>
<form method="get" class="seccion-formulario"><div class="grid-dos-columnas"><div class="campo-formulario"><label>Año</label><input name="anio" type="number" value="@Model.Anio"/></div><div class="campo-formulario"><label>Estado cuotas</label><input name="estadoCuotas" value="@Model.EstadoCuotas" placeholder="Pendientes/Pagadas"/></div></div><button class="boton-primario" type="submit">Filtrar</button></form>
<h3>Planes</h3><table class="tabla-base"><thead><tr><th>Plan</th><th>Finca</th><th>Año</th><th>Pagadas</th><th>Pendientes</th></tr></thead><tbody>@foreach(var i in Model.Planes){<tr><td>@i.IdPlanPago</td><td>@i.NombreFinca</td><td>@i.Anio</td><td>@i.CuotasPagadas</td><td>@i.CuotasPendientes</td></tr>}</tbody></table>
<h3>Pagos por ubicación</h3><table class="tabla-base"><thead><tr><th>Año/Mes</th><th>Provincia</th><th>Cantón</th><th>Distrito</th><th>Pagado</th></tr></thead><tbody>@foreach(var i in Model.PagosPorUbicacion){<tr><td>@i.Anio/@i.Mes</td><td>@i.Provincia</td><td>@i.Canton</td><td>@i.Distrito</td><td>@i.MontoPagadoMes.ToString("N2")</td></tr>}</tbody></table></section>
