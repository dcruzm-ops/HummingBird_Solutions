@model PSA.WebApp.Models.ReporteAdminAuditoriaViewModel
<section class="seccion-pagina"><h2>Auditoría crítica</h2>
<form method="get" class="seccion-formulario"><div class="grid-tres-columnas"><div class="campo-formulario"><label>Módulo</label><select name="modulo"><option value="">Todos</option><option value="Autenticacion" selected="@(Model.Modulo == "Autenticacion")">Autenticación</option><option value="Usuarios" selected="@(Model.Modulo == "Usuarios")">Usuarios</option><option value="Fincas" selected="@(Model.Modulo == "Fincas")">Fincas</option><option value="Evaluaciones" selected="@(Model.Modulo == "Evaluaciones")">Evaluaciones</option><option value="Pagos" selected="@(Model.Modulo == "Pagos")">Pagos</option><option value="Parametros" selected="@(Model.Modulo == "Parametros")">Parámetros</option></select></div><div class="campo-formulario"><label>Acción</label><select name="accion"><option value="">Todas</option><option value="INSERT" selected="@(Model.Accion == "INSERT")">INSERT</option><option value="UPDATE" selected="@(Model.Accion == "UPDATE")">UPDATE</option><option value="DELETE" selected="@(Model.Accion == "DELETE")">DELETE</option><option value="LOGIN" selected="@(Model.Accion == "LOGIN")">LOGIN</option></select></div><div class="campo-formulario"><label>Top</label><input name="top" type="number" min="1" max="200" value="@Model.Top"/></div></div><button class="boton-primario" type="submit">Filtrar</button></form>
<table class="tabla-base"><thead><tr><th>Fecha</th><th>Módulo</th><th>Tabla</th><th>Acción</th><th>Usuario</th><th>Detalle</th></tr></thead><tbody>@foreach(var i in Model.Items){<tr><td>@i.FechaAccion.ToString("yyyy-MM-dd HH:mm")</td><td>@i.Modulo</td><td>@i.TablaAfectada</td><td>@i.Accion</td><td>@i.Usuario</td><td>@i.Detalle</td></tr>}</tbody></table></section>
