@model PSA.WebApp.Models.ReporteAdminUsuariosViewModel

<section class="seccion-pagina">
    <h2>Usuarios y roles</h2>

    <form method="get" class="seccion-formulario">
        <div class="grid-dos-columnas">
            <div class="campo-formulario">
                <label>Rol</label>
                <select name="rol">
                    <option value="">Todos</option>
                    <option value="Administrador" selected="@(Model.Rol == "Administrador")">Administrador</option>
                    <option value="Propietario" selected="@(Model.Rol == "Propietario")">Propietario</option>
                    <option value="Ingeniero Forestal" selected="@(Model.Rol == "Ingeniero Forestal")">Ingeniero Forestal</option>
                </select>
            </div>
            <div class="campo-formulario">
                <label>Estado</label>
                <select name="estado">
                    <option value="">Todos</option>
                    <option value="Activo" selected="@(Model.Estado == "Activo")">Activo</option>
                    <option value="Inactivo" selected="@(Model.Estado == "Inactivo")">Inactivo</option>
                    <option value="Bloqueado" selected="@(Model.Estado == "Bloqueado")">Bloqueado</option>
                </select>
            </div>
        </div>
        <button class="boton-primario" type="submit">Filtrar</button>
    </form>

    <table class="tabla-base">
        <thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Estado</th></tr></thead>
        <tbody>
            @foreach (var i in Model.Items)
            {
                <tr><td>@i.NombreCompleto</td><td>@i.Email</td><td>@i.Rol</td><td>@i.Estado</td></tr>
            }
        </tbody>
    </table>
</section>
