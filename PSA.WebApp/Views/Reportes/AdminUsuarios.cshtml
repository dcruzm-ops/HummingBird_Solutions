@model PSA.WebApp.Models.ReporteAdminUsuariosViewModel
<section class="seccion-pagina"><h2>Usuarios y roles</h2>
<form method="get" class="seccion-formulario"><div class="grid-dos-columnas"><div class="campo-formulario"><label>Rol</label><select name="rol"><option value="">Todos</option><option value="Administrador" selected="@(Model.Rol == "Administrador")">Administrador</option><option value="Dueño" selected="@(Model.Rol == "Dueño")">Dueño</option><option value="Dueno" selected="@(Model.Rol == "Dueno")">Dueno</option><option value="Ingeniero" selected="@(Model.Rol == "Ingeniero")">Ingeniero</option></select></div><div class="campo-formulario"><label>Estado</label><select name="estado"><option value="">Todos</option><option value="Activo" selected="@(Model.Estado == "Activo")">Activo</option><option value="Inactivo" selected="@(Model.Estado == "Inactivo")">Inactivo</option><option value="Bloqueado" selected="@(Model.Estado == "Bloqueado")">Bloqueado</option></select></div></div><button class="boton-primario" type="submit">Filtrar</button></form>
<table class="tabla-base"><thead><tr><th>Nombre</th><th>Email</th><th>Rol</th><th>Estado</th></tr></thead><tbody>@foreach(var i in Model.Items){<tr><td>@i.NombreCompleto</td><td>@i.Email</td><td>@i.Rol</td><td>@i.Estado</td></tr>}</tbody></table></section>
