@model PSA.WebApp.Models.ReporteAdminEvaluacionesViewModel

<section class="seccion-pagina">
    <h2>Evaluaciones técnicas</h2>

    <form method="get" class="seccion-formulario">
        <div class="grid-cuatro-columnas">
            <div class="campo-formulario">
                <label>Año</label>
                <input name="anio" type="number" value="@Model.Anio" />
            </div>
            <div class="campo-formulario">
                <label>Mes</label>
                <select name="mes">
                    <option value="">Todos</option>
                    @for (var m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(Model.Mes == m)">@m</option>
                    }
                </select>
            </div>
            <div class="campo-formulario">
                <label>Estado</label>
                <select name="estado">
                    <option value="">Todos</option>
                    <option value="Pendiente" selected="@(Model.Estado == "Pendiente")">Pendiente</option>
                    <option value="En proceso" selected="@(Model.Estado == "En proceso")">En proceso</option>
                    <option value="Evaluada – Califica" selected="@(Model.Estado == "Evaluada – Califica")">Evaluada – Califica</option>
                    <option value="Evaluada – No califica" selected="@(Model.Estado == "Evaluada – No califica")">Evaluada – No califica</option>
                </select>
            </div>
            <div class="campo-formulario">
                <label>Decisión</label>
                <select name="decision">
                    <option value="">Todas</option>
                    <option value="Califica" selected="@(Model.Decision == "Califica")">Califica</option>
                    <option value="No Califica" selected="@(Model.Decision == "No Califica")">No califica</option>
                </select>
            </div>
        </div>
        <button class="boton-primario" type="submit">Filtrar</button>
    </form>

    <table class="tabla-base">
        <thead><tr><th>Evaluación</th><th>Finca</th><th>Ingeniero</th><th>Estado</th><th>Decisión</th><th>Fecha</th></tr></thead>
        <tbody>
            @foreach (var i in Model.Items)
            {
                <tr><td>@i.IdEvaluacion</td><td>@i.NombreFinca</td><td>@i.Ingeniero</td><td>@i.EstadoEvaluacion</td><td>@i.DecisionTecnica</td><td>@((i.FechaDecision ?? i.FechaVisita)?.ToString("yyyy-MM-dd"))</td></tr>
            }
        </tbody>
    </table>
</section>
