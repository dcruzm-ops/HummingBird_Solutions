@model PSA.WebApp.Models.ReporteAdminEvaluacionesViewModel
<section class="seccion-pagina"><h2>Evaluaciones técnicas</h2>
<form method="get" class="seccion-formulario"><div class="grid-cuatro-columnas"><div class="campo-formulario"><label>Año</label><input name="anio" type="number" value="@Model.Anio"/></div><div class="campo-formulario"><label>Mes</label><input name="mes" type="number" value="@Model.Mes"/></div><div class="campo-formulario"><label>Estado</label><input name="estado" value="@Model.Estado"/></div><div class="campo-formulario"><label>Decisión</label><input name="decision" value="@Model.Decision"/></div></div><button class="boton-primario" type="submit">Filtrar</button></form>
<table class="tabla-base"><thead><tr><th>Eval</th><th>Finca</th><th>Ingeniero</th><th>Estado</th><th>Decisión</th><th>Fecha</th></tr></thead><tbody>@foreach(var i in Model.Items){<tr><td>@i.IdEvaluacion</td><td>@i.NombreFinca</td><td>@i.Ingeniero</td><td>@i.EstadoEvaluacion</td><td>@i.DecisionTecnica</td><td>@((i.FechaDecision??i.FechaVisita)?.ToString("yyyy-MM-dd"))</td></tr>}</tbody></table></section>
