@model PSA.WebApp.Models.ReporteEvaluacionesViewModel
@{
    ViewData["Title"] = "Historial de evaluaciones";
}
<section class="seccion-pagina">
    <div class="cabecera-pagina">
        <div>
            <span class="eyebrow">Reporte técnico</span>
            <h2>Reportes mensuales y anuales</h2>
            <p>Consulte evaluaciones por período, estado y decisión técnica.</p>
        </div>
        <a class="boton-secundario" asp-controller="Evaluaciones" asp-action="FincasPendientes">Volver a pendientes</a>
    </div>

    <section class="tarjeta-panel">
        <form method="get" asp-controller="Evaluaciones" asp-action="HistorialEvaluaciones" class="formulario-base formulario-modulo" data-omitir-trobber-global="true">
            <p id="mensajeFiltroPeriodo" class="text-danger" style="display:none;"></p>
            <div class="grid-dos-columnas">
                <div class="campo-formulario">
                    <label for="anio">Año</label>
                    <input type="number" id="anio" name="anio" min="2000" max="2100" value="@Model.Anio" />
                </div>
                <div class="campo-formulario">
                    <label for="mes">Mes</label>
                    <select id="mes" name="mes">
                        <option value="">Todos</option>
                        @for (var i = 1; i <= 12; i++)
                        {
                            if (Model.Mes == i)
                            {
                                <option value="@i" selected="selected">@i</option>
                            }
                            else
                            {
                                <option value="@i">@i</option>
                            }
                        }
                    </select>
                </div>
                <div class="campo-formulario">
                    <label for="estadoEvaluacion">Estado evaluación</label>
                    <select id="estadoEvaluacion" name="estadoEvaluacion">
                        <option value="">Todos</option>
                        @if (Model.EstadoEvaluacion == "Pendiente")
                        {
                            <option value="Pendiente" selected="selected">Pendiente</option>
                        }
                        else
                        {
                            <option value="Pendiente">Pendiente</option>
                        }
                        @if (Model.EstadoEvaluacion == "En proceso")
                        {
                            <option value="En proceso" selected="selected">En proceso</option>
                        }
                        else
                        {
                            <option value="En proceso">En proceso</option>
                        }
                        @if (Model.EstadoEvaluacion == "Evaluada – Califica")
                        {
                            <option value="Evaluada – Califica" selected="selected">Evaluada – Califica</option>
                        }
                        else
                        {
                            <option value="Evaluada – Califica">Evaluada – Califica</option>
                        }
                        @if (Model.EstadoEvaluacion == "Evaluada – No califica")
                        {
                            <option value="Evaluada – No califica" selected="selected">Evaluada – No califica</option>
                        }
                        else
                        {
                            <option value="Evaluada – No califica">Evaluada – No califica</option>
                        }
                    </select>
                </div>
                <div class="campo-formulario">
                    <label for="decisionTecnica">Decisión técnica</label>
                    <select id="decisionTecnica" name="decisionTecnica">
                        <option value="">Todas</option>
                        @if (Model.DecisionTecnica == "Califica")
                        {
                            <option value="Califica" selected="selected">Califica</option>
                        }
                        else
                        {
                            <option value="Califica">Califica</option>
                        }
                        @if (Model.DecisionTecnica == "No califica")
                        {
                            <option value="No califica" selected="selected">No califica</option>
                        }
                        else
                        {
                            <option value="No califica">No califica</option>
                        }
                    </select>
                </div>
            </div>
            <div class="fila-acciones-formulario">
                <button type="submit" class="boton-primario">Filtrar reporte</button>
            </div>
        </form>
    </section>

    <div class="grid-tarjetas-kpi">
        <article class="tarjeta-kpi">
            <span class="etiqueta-kpi">Total evaluaciones</span>
            <strong>@Model.Reporte.TotalEvaluaciones</strong>
        </article>
        <article class="tarjeta-kpi">
            <span class="etiqueta-kpi">Califica</span>
            <strong>@Model.Reporte.TotalCalifica</strong>
        </article>
        <article class="tarjeta-kpi">
            <span class="etiqueta-kpi">No califica</span>
            <strong>@Model.Reporte.TotalNoCalifica</strong>
        </article>
        <article class="tarjeta-kpi">
            <span class="etiqueta-kpi">Pendientes / en proceso</span>
            <strong>@Model.Reporte.TotalPendientes</strong>
        </article>
    </div>

    <section class="tarjeta-panel">
        <div class="tabla-responsive">
            <table class="tabla-base">
                <thead>
                    <tr>
                        <th>Evaluación</th>
                        <th>Finca</th>
                        <th>Ubicación</th>
                        <th>Estado</th>
                        <th>Decisión</th>
                        <th>Fecha visita</th>
                        <th>Fecha decisión</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Reporte.Evaluaciones.Any())
                    {
                        foreach (var item in Model.Reporte.Evaluaciones)
                        {
                            <tr>
                                <td>#@item.IdEvaluacion</td>
                                <td>@item.NombreFinca</td>
                                <td>@item.Provincia, @item.Canton, @item.Distrito</td>
                                <td>@item.EstadoEvaluacion</td>
                                <td>@(string.IsNullOrWhiteSpace(item.DecisionTecnica) ? "N/A" : item.DecisionTecnica)</td>
                                <td>@(item.FechaVisita?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                <td>@(item.FechaDecision?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                <td>
                                    <a class="boton-link" asp-controller="Evaluaciones" asp-action="DetalleEvaluacion" asp-route-idEvaluacion="@item.IdEvaluacion">Ver detalle</a>
                                    @if (string.Equals(item.EstadoEvaluacion, "Evaluada – Califica", StringComparison.OrdinalIgnoreCase)
                                            && string.Equals(item.DecisionTecnica, "Califica", StringComparison.OrdinalIgnoreCase)
                                            && !item.TienePlanPago)
                                    {
                                        <form method="post" asp-controller="Evaluaciones" asp-action="GenerarPlanManual" class="mt-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="idFinca" value="@item.IdFinca" />
                                            <button type="submit" class="boton-secundario">Generar plan manual</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8">No hay evaluaciones para los filtros seleccionados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('form[asp-action="HistorialEvaluaciones"], form[action*="HistorialEvaluaciones"]');
            if (!form) return;

            form.addEventListener('submit', function (event) {
                const anio = document.getElementById('anio')?.value?.trim();
                const mes = document.getElementById('mes')?.value?.trim();
                const mensaje = document.getElementById('mensajeFiltroPeriodo');

                if (mes && !anio) {
                    event.preventDefault();
                    if (window.psa && typeof window.psa.ocultarTrobberGlobal === 'function') {
                        window.psa.ocultarTrobberGlobal();
                    }
                    if (mensaje) {
                        mensaje.style.display = 'block';
                        mensaje.textContent = 'Para filtrar por mes debe indicar también el año.';
                    }
                    document.getElementById('anio')?.focus();
                    return;
                }

                if (window.psa && typeof window.psa.mostrarTrobberGlobal === 'function') {
                    window.psa.mostrarTrobberGlobal();
                }
            });
        });
    </script>
}
