@model PSA.WebApp.Models.NuevaEvaluacionViewModel
@{
    ViewData["Title"] = "Nueva evaluación técnica";
    var evidenciasExistentes = Model.EvidenciasExistentes ?? new List<PSA.EntidadesDTO.DTOs.Fincas.FincaEvidenciaDTO>();
}
<section class="seccion-pagina">
    <div class="cabecera-pagina">
        <div>
            <span class="eyebrow">Expediente técnico</span>
            <h2>Evaluación técnica #@Model.Detalle.IdEvaluacion</h2>
            <p>Finca: <strong>@Model.Detalle.NombreFinca</strong> (@Model.Detalle.Provincia, @Model.Detalle.Canton, @Model.Detalle.Distrito)</p>
        </div>
    </div>

    <form class="formulario-base formulario-modulo" id="formularioNuevaEvaluacion" method="post" asp-controller="Evaluaciones" asp-action="NuevaEvaluacion" asp-route-idEvaluacion="@Model.Detalle.IdEvaluacion" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="seccion-formulario">
            <h3>Datos capturados por el dueño (original)</h3>
            <div class="grid-dos-columnas">
                <div class="campo-formulario"><label>Hectáreas</label><input value="@Model.Detalle.Hectareas.ToString("N2")" readonly /></div>
                <div class="campo-formulario">
                    <label>Pendiente</label>
                    <select disabled>
                        @foreach (var opcion in (IEnumerable<string>)ViewBag.CatalogoPendiente)
                        {
                            if (string.Equals(opcion, Model.Detalle.Pendiente, System.StringComparison.OrdinalIgnoreCase))
                            {
                                <option selected="selected">@opcion</option>
                            }
                            else
                            {
                                <option>@opcion</option>
                            }
                        }
                    </select>
                </div>
                <div class="campo-formulario">
                    <label>Vegetación</label>
                    <select disabled>
                        @foreach (var opcion in (IEnumerable<string>)ViewBag.CatalogoVegetacion)
                        {
                            if (string.Equals(opcion, Model.Detalle.Vegetacion, System.StringComparison.OrdinalIgnoreCase))
                            {
                                <option selected="selected">@opcion</option>
                            }
                            else
                            {
                                <option>@opcion</option>
                            }
                        }
                    </select>
                </div>
                <div class="campo-formulario">
                    <label>Uso de suelo</label>
                    <select disabled>
                        @foreach (var opcion in (IEnumerable<string>)ViewBag.CatalogoUsoSuelo)
                        {
                            if (string.Equals(opcion, Model.Detalle.UsoSuelo, System.StringComparison.OrdinalIgnoreCase))
                            {
                                <option selected="selected">@opcion</option>
                            }
                            else
                            {
                                <option>@opcion</option>
                            }
                        }
                    </select>
                </div>
                <div class="campo-formulario">
                    <label>Recursos hídricos</label>
                    <select disabled>
                        @if (Model.Detalle.TieneRecursosHidricos)
                        {
                            <option selected="selected">Sí</option>
                            <option>No</option>
                        }
                        else
                        {
                            <option>Sí</option>
                            <option selected="selected">No</option>
                        }
                    </select>
                </div>

                <div class="campo-formulario">
                    <label>Estado evaluación</label>
                    <select disabled>
                        @foreach (var opcion in (IEnumerable<string>)ViewBag.CatalogoEstadoEvaluacion)
                        {
                            if (string.Equals(opcion, Model.Detalle.EstadoEvaluacion, System.StringComparison.OrdinalIgnoreCase))
                            {
                                <option selected="selected">@opcion</option>
                            }
                            else
                            {
                                <option>@opcion</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="Formulario.DecisionTecnica" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="seccion-formulario">
            <h3>Registro de visita y decisión técnica</h3>
            <div class="grid-dos-columnas">
                <div class="campo-formulario">
                    <label asp-for="Formulario.FechaVisita">Fecha de visita</label>
                    <input asp-for="Formulario.FechaVisita" type="date" required />
                    <span asp-validation-for="Formulario.FechaVisita" class="text-danger"></span>
                </div>
                <div class="campo-formulario">
                    <label asp-for="Formulario.DecisionTecnica">Decisión técnica</label>
                    <select asp-for="Formulario.DecisionTecnica" required>
                        <option value="">Seleccione...</option>
                        <option value="Califica">Califica</option>
                        <option value="No Califica">No califica</option>
                    </select>
                    <span asp-validation-for="Formulario.DecisionTecnica" class="text-danger"></span>
                </div>
            </div>
            <div class="campo-formulario">
                <label asp-for="Formulario.Observaciones">Observaciones</label>
                <textarea asp-for="Formulario.Observaciones" rows="5" placeholder="Hallazgos de campo, validación de datos y criterio técnico"></textarea>
            </div>
            <div class="campo-formulario">
                <label>Evidencias (opcional)</label>
                <input asp-for="Evidencias" type="file" multiple accept="image/*,.pdf" />
                <small>Nota: la persistencia de archivos físicos se gestiona en el flujo de evidencias.</small>
            </div>
        </div>

        <div class="seccion-formulario">
            <h3>Evidencias existentes de la finca</h3>
            @if (evidenciasExistentes.Count > 0)
            {
                <div class="lista-evidencias">
                    @foreach (var evidencia in evidenciasExistentes)
                    {
                        var esImagen = !string.IsNullOrWhiteSpace(evidencia.TipoArchivo) && evidencia.TipoArchivo.StartsWith("image/", StringComparison.OrdinalIgnoreCase);
                        var esPdf = string.Equals(evidencia.TipoArchivo, "application/pdf", StringComparison.OrdinalIgnoreCase)
                            || evidencia.NombreArchivo.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);

                        <article class="evidencia-item">
                            <header>
                                <strong>@evidencia.NombreArchivo</strong>
                                <div class="texto-ayuda">Subido: @evidencia.FechaCarga.ToString("dd/MM/yyyy HH:mm")</div>
                            </header>

                            @if (esImagen && !string.IsNullOrWhiteSpace(evidencia.UrlDescarga))
                            {
                                <img src="@evidencia.UrlDescarga" alt="@evidencia.NombreArchivo" class="evidencia-preview-imagen" />
                            }
                            else if (esPdf && !string.IsNullOrWhiteSpace(evidencia.UrlDescarga))
                            {
                                <iframe src="@evidencia.UrlDescarga" title="@evidencia.NombreArchivo" class="evidencia-preview-pdf"></iframe>
                            }
                            else
                            {
                                <p class="texto-ayuda">Vista previa no disponible para este tipo de archivo.</p>
                            }

                            @if (!string.IsNullOrWhiteSpace(evidencia.UrlDescarga))
                            {
                                <a href="@evidencia.UrlDescarga" target="_blank" rel="noopener" class="boton-secundario">Abrir archivo</a>
                            }
                        </article>
                    }
                </div>
            }
            else
            {
                <p>No hay evidencias previas registradas para esta finca.</p>
            }
        </div>

        <div class="seccion-formulario">
            <h3>Ajustes técnicos del ingeniero</h3>
            <p class="texto-ajustes-tecnicos">Estos campos en verde permiten registrar el dato ajustado y mantener trazabilidad respecto al dato original.</p>
            <div class="grid-dos-columnas">
                <div class="campo-formulario campo-ajustable">
                    <label asp-for="Formulario.HectareasAjustadas">Hectáreas ajustadas</label>
                    <input asp-for="Formulario.HectareasAjustadas" type="number" step="0.01" min="0.01" />
                </div>
                <div class="campo-formulario campo-ajustable">
                    <label asp-for="Formulario.PendienteAjustada">Pendiente ajustada</label>
                    <select asp-for="Formulario.PendienteAjustada">
                        <option value="">Sin ajuste</option>
                        @foreach (var opcion in (IEnumerable<string>)ViewBag.CatalogoPendiente)
                        {
                            <option value="@opcion">@opcion</option>
                        }
                    </select>
                </div>
                <div class="campo-formulario campo-ajustable">
                    <label asp-for="Formulario.VegetacionAjustada">Vegetación ajustada</label>
                    <select asp-for="Formulario.VegetacionAjustada">
                        <option value="">Sin ajuste</option>
                        @foreach (var opcion in (IEnumerable<string>)ViewBag.CatalogoVegetacion)
                        {
                            <option value="@opcion">@opcion</option>
                        }
                    </select>
                </div>
                <div class="campo-formulario campo-ajustable">
                    <label asp-for="Formulario.UsoSueloAjustado">Uso de suelo ajustado</label>
                    <select asp-for="Formulario.UsoSueloAjustado">
                        <option value="">Sin ajuste</option>
                        @foreach (var opcion in (IEnumerable<string>)ViewBag.CatalogoUsoSuelo)
                        {
                            <option value="@opcion">@opcion</option>
                        }
                    </select>
                </div>
                <div class="campo-formulario campo-ajustable">
                    <label asp-for="Formulario.RecursosHidricosAjustado">Recursos hídricos ajustados</label>
                    <select asp-for="Formulario.RecursosHidricosAjustado">
                        <option value="">Sin ajuste</option>
                        <option value="true">Sí</option>
                        <option value="false">No</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="fila-acciones-formulario">
            <a class="boton-secundario" asp-controller="Evaluaciones" asp-action="FincasPendientes">Cancelar</a>
            <button type="submit" class="boton-primario">Guardar evaluación</button>
        </div>
    </form>
</section>

@section Scripts {
    <script src="~/js/evaluaciones.js" asp-append-version="true"></script>
}


