@model PSA.EntidadesDTO.DTOs.Evaluaciones.DetalleFincaParaEvaluacionDTO
@{
    ViewData["Title"] = "Detalle de evaluación";
}
<section class="seccion-pagina">
    <div class="cabecera-pagina">
        <div>
            <span class="eyebrow">Evaluación #@Model.IdEvaluacion</span>
            <h2>@Model.NombreFinca</h2>
            <p>@Model.Provincia, @Model.Canton, @Model.Distrito</p>
        </div>
        <a class="boton-secundario" asp-controller="Evaluaciones" asp-action="FincasIngeniero">Volver</a>
    </div>

    <div class="grid-dos-paneles">
        <section class="tarjeta-panel">
            <h3>Datos originales</h3>
            <ul class="lista-timeline">
                <li>Hectáreas: @Model.HectareasOriginales</li>
                <li>Vegetación: @Model.VegetacionOriginal</li>
                <li>Uso de suelo: @Model.UsoSueloOriginal</li>
                <li>Pendiente: @Model.PendienteOriginal</li>
                <li>Ríos/Quebradas: @(Model.TieneRiosOQuebradasOriginal ? "Sí" : "No")</li>
                <li>Cantidad de nacientes: @Model.CantidadNacientesOriginal</li>
                <li>Estado evaluación: @Model.EstadoEvaluacion</li>
            </ul>
        </section>

        <section class="tarjeta-panel">
            <h3>Resultado técnico</h3>
            <ul class="lista-timeline">
                <li>Fecha visita: @(Model.FechaVisita?.ToString("dd/MM/yyyy") ?? "N/A")</li>
                <li>Fecha decisión: @(Model.FechaDecision?.ToString("dd/MM/yyyy") ?? "N/A")</li>
                <li>Decisión técnica: @(string.IsNullOrWhiteSpace(Model.DecisionTecnica) ? "N/A" : Model.DecisionTecnica)</li>
                <li>Observaciones: @(string.IsNullOrWhiteSpace(Model.Observaciones) ? "N/A" : Model.Observaciones)</li>
            </ul>
        </section>
    </div>

    <section class="tarjeta-panel">
        <h3>Ajustes registrados</h3>
        <ul class="lista-timeline">
            <li>Hectáreas ajustadas: @(Model.HectareasAjustadas?.ToString("N2") ?? "Sin ajuste")</li>
            <li>Vegetación ajustada: @(string.IsNullOrWhiteSpace(Model.VegetacionAjustada) ? "Sin ajuste" : Model.VegetacionAjustada)</li>
            <li>Uso de suelo ajustado: @(string.IsNullOrWhiteSpace(Model.UsoSueloAjustado) ? "Sin ajuste" : Model.UsoSueloAjustado)</li>
            <li>Pendiente ajustada: @(string.IsNullOrWhiteSpace(Model.PendienteAjustada) ? "Sin ajuste" : Model.PendienteAjustada)</li>
            <li>Ríos/Quebradas ajustado: @(Model.TieneRiosOQuebradasAjustado.HasValue ? (Model.TieneRiosOQuebradasAjustado.Value ? "Sí" : "No") : "Sin ajuste")</li>
            <li>Cantidad nacientes ajustada: @(Model.CantidadNacientesAjustada.HasValue ? Model.CantidadNacientesAjustada.Value.ToString() : "Sin ajuste")</li>
        </ul>
    </section>

    <section class="tarjeta-panel">
        <h3>Impacto en Plan de Pago</h3>
        @{
            var impacto = ViewBag.ImpactoPago as PSA.EntidadesDTO.DTOs.Pagos.EngineerPaymentImpactDto;
        }
        @if (impacto == null)
        {
            <p class="text-muted">No hay información de impacto de pago para esta evaluación.</p>
        }
        else
        {
            <ul class="lista-timeline">
                <li>Decisión técnica: @impacto.DecisionTecnica</li>
                <li>¿Generó plan?: @(impacto.GeneroPlan ? "Sí" : "No")</li>
                <li>Estado de continuidad: @impacto.EstadoContinuidad</li>
                <li>Cuenta bancaria: @impacto.EstadoCuentaBancaria (solo indicador)</li>
                <li>Monto mensual referencial: @(impacto.MontoMensualReferencial.HasValue ? $"₡{impacto.MontoMensualReferencial.Value:N2}" : "No aplica")</li>
                <li>Monto anual referencial: @(impacto.MontoAnualReferencial.HasValue ? $"₡{impacto.MontoAnualReferencial.Value:N2}" : "No aplica")</li>
            </ul>

            @if (impacto.PuedeAprobarFinal && impacto.IdPlanPago.HasValue)
            {
                <form method="post" asp-controller="Evaluaciones" asp-action="AprobarActivacionPlanPago" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idEvaluacion" value="@Model.IdEvaluacion" />
                    <input type="hidden" name="idPlanPago" value="@impacto.IdPlanPago.Value" />
                    <button type="submit" class="boton-secundario">Activar plan de pago</button>
                </form>
            }
            else if (string.Equals(impacto.EstadoPlan, PSA.EntidadesDTO.DTOs.Pagos.EstadosPlanPago.Activo, StringComparison.OrdinalIgnoreCase))
            {
                <p class="text-success mt-2"><strong>Plan activo.</strong> No hay acciones pendientes.</p>
            }
        }
    </section>
</section>
