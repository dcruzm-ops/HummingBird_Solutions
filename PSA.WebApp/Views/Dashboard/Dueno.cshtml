@{
    ViewData["Title"] = "Dashboard del dueño";
    var actividadReciente = ViewBag.ActividadReciente as List<string> ?? new List<string>();
}
<section class="seccion-pagina propietario-dashboard">
    <div class="cabecera-pagina">
        <div>
            <span class="eyebrow">Vista general</span>
            <h2>Resumen del propietario</h2>
            <p>Seguimiento rápido de fincas, evaluaciones, pagos y notificaciones.</p>
        </div>
        <a class="boton-primario" asp-controller="Fincas" asp-action="RegistrarFinca">Registrar finca</a>
    </div>

    <div class="grid-tarjetas-kpi">
        <article class="tarjeta-kpi">
            <span class="etiqueta-kpi">Fincas registradas</span>
            <strong>@(ViewBag.TotalFincas ?? 0)</strong>
            <small>@(ViewBag.FincasActivas ?? 0) activas y @(ViewBag.EnRevision ?? 0) en revisión</small>
        </article>
        <article class="tarjeta-kpi">
            <span class="etiqueta-kpi">Evaluaciones pendientes</span>
            <strong>@(ViewBag.EvaluacionesPendientes ?? 0)</strong>
            <small>Resumen calculado desde sus fincas registradas</small>
        </article>
        <article class="tarjeta-kpi">
            <span class="etiqueta-kpi">Cuotas por confirmar</span>
            <strong>@Math.Max(0, (int)(ViewBag.EvaluacionesPendientes ?? 0) - (int)(ViewBag.EnRevision ?? 0))</strong>
            <small>Estimación operativa para próximos pagos</small>
        </article>
    </div>

    <div class="grid-dos-paneles">
        <section class="tarjeta-panel">
            <div class="cabecera-bloque">
                <h3>Accesos rápidos</h3>
            </div>
            <div class="lista-accesos">
                <a class="acceso-rapido" asp-controller="Fincas" asp-action="MisFincas">Mis fincas</a>
                <a class="acceso-rapido" asp-controller="Pagos" asp-action="HistorialPagos">Historial de pagos</a>
                <a class="acceso-rapido" asp-controller="Notificaciones" asp-action="Index">Notificaciones</a>
            </div>
        </section>

        <section class="tarjeta-panel">
            <div class="cabecera-bloque">
                <h3>Actividad reciente</h3>
            </div>
            <ul class="lista-timeline">
                @if (actividadReciente.Count == 0)
                {
                    <li>No hay actividad reciente para mostrar.</li>
                }
                else
                {
                    foreach (var item in actividadReciente)
                    {
                        <li>@item</li>
                    }
                }
            </ul>
        </section>
    </div>
</section>
