@{
    ViewData["Title"] = "Dashboard del administrador";
    var alertas = ViewBag.AlertasAdministrativas as List<string> ?? new List<string>();
    var actividad = ViewBag.ActividadAuditoria as List<PSA.EntidadesDTO.DTOs.Dashboard.ActividadAuditoriaDTO>
        ?? new List<PSA.EntidadesDTO.DTOs.Dashboard.ActividadAuditoriaDTO>();
}
<section class="seccion-pagina administrador-dashboard">
    <div class="cabecera-pagina">
        <div>
            <span class="eyebrow">Vista operativa</span>
            <h2>Resumen administrativo</h2>
            <p>Monitoree usuarios, parámetros, validaciones bancarias y auditoría.</p>
        </div>
        <a class="boton-primario" asp-controller="Administracion" asp-action="GestionUsuarios">Gestionar usuarios</a>
    </div>

    <div class="grid-tarjetas-kpi">
        <article class="tarjeta-kpi">
            <span class="etiqueta-kpi">Usuarios activos</span>
            <strong>@(ViewBag.UsuariosActivos ?? 0)</strong>
            <small>@(ViewBag.UsuariosPendientesAprobacion ?? 0) inactivos o bloqueados</small>
        </article>
        <article class="tarjeta-kpi">
            <span class="etiqueta-kpi">Usuarios nuevos hoy</span>
            <strong>@(ViewBag.UsuariosNuevosHoy ?? 0)</strong>
            <small>Registros con fecha de creación de hoy</small>
        </article>
        <article class="tarjeta-kpi">
            <span class="etiqueta-kpi">Cuentas por validar</span>
            <strong>@(ViewBag.CuentasPorValidar ?? 0)</strong>
            <small>Revisión administrativa requerida</small>
        </article>
        <article class="tarjeta-kpi">
            <span class="etiqueta-kpi">Eventos de auditoría</span>
            <strong>@(ViewBag.EventosAuditoria24h ?? 0)</strong>
            <small>Total acumulado</small>
        </article>
    </div>

    <section class="tarjeta-panel">
        <div class="cabecera-bloque">
            <h3>Alertas administrativas</h3>
        </div>
        <ul class="lista-timeline">
            @if (alertas.Count == 0)
            {
                <li>No hay alertas administrativas registradas en este momento.</li>
            }
            else
            {
                foreach (var alerta in alertas)
                {
                    <li>@alerta</li>
                }
            }
        </ul>
    </section>

    <section class="tarjeta-panel mt-4">
        <div class="cabecera-bloque">
            <h3>Actividad de auditoría reciente</h3>
        </div>
        <ul class="lista-timeline">
            @if (actividad.Count == 0)
            {
                <li>No hay actividad de auditoría registrada.</li>
            }
            else
            {
                foreach (var evento in actividad)
                {
                    <li>
                        <strong>@evento.Modulo</strong> · @evento.Accion<br />
                        <span>@evento.Detalle</span><br />
                        <small>@evento.FechaAccion.ToString("dd/MM/yyyy HH:mm")</small>
                    </li>
                }
            }
        </ul>
    </section>
</section>
