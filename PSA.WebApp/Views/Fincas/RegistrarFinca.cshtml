@model PSA.EntidadesDTO.DTOs.RegistrarFincaDTO
@{
    ViewData["Title"] = "Registrar finca";
}
<section class="seccion-pagina">
    <div class="cabecera-pagina">
        <div>
            <span class="eyebrow">Nuevo registro</span>
            <h2>Formulario de finca</h2>
            <p>Complete los datos para registrar una finca en el sistema PSA Costa Rica.</p>
        </div>
    </div>

    <form class="formulario-base formulario-modulo" id="formularioRegistrarFinca" novalidate method="post" asp-controller="Fincas" asp-action="RegistrarFinca">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="seccion-formulario">
            <h3>Datos generales</h3>
            <div class="grid-dos-columnas">
                <div class="campo-formulario">
                    <label asp-for="NombreFinca"></label>
                    <input asp-for="NombreFinca" placeholder="Nombre de la finca" />
                    <span asp-validation-for="NombreFinca" class="text-danger"></span>
                </div>
                <div class="campo-formulario">
                    <label asp-for="Provincia"></label>
                    <input asp-for="Provincia" placeholder="Provincia" />
                    <span asp-validation-for="Provincia" class="text-danger"></span>
                </div>
            </div>

            <div class="grid-dos-columnas">
                <div class="campo-formulario">
                    <label asp-for="Canton"></label>
                    <input asp-for="Canton" placeholder="Cantón" />
                    <span asp-validation-for="Canton" class="text-danger"></span>
                </div>
                <div class="campo-formulario">
                    <label asp-for="Distrito"></label>
                    <input asp-for="Distrito" placeholder="Distrito" />
                    <span asp-validation-for="Distrito" class="text-danger"></span>
                </div>
            </div>

            <div class="campo-formulario">
                <label asp-for="DireccionExacta"></label>
                <textarea asp-for="DireccionExacta" rows="3" placeholder="Dirección exacta (opcional)"></textarea>
                <span asp-validation-for="DireccionExacta" class="text-danger"></span>
            </div>
        </div>

        <div class="seccion-formulario">
            <h3>Ubicación y características</h3>
            <div class="grid-tres-columnas">
                <div class="campo-formulario">
                    <label asp-for="Latitud"></label>
                    <input asp-for="Latitud" type="number" step="0.0000001" />
                    <span asp-validation-for="Latitud" class="text-danger"></span>
                </div>
                <div class="campo-formulario">
                    <label asp-for="Longitud"></label>
                    <input asp-for="Longitud" type="number" step="0.0000001" />
                    <span asp-validation-for="Longitud" class="text-danger"></span>
                </div>
                <div class="campo-formulario">
                    <label asp-for="Hectareas"></label>
                    <input asp-for="Hectareas" type="number" min="0.01" step="0.01" />
                    <span asp-validation-for="Hectareas" class="text-danger"></span>
                </div>
            </div>

            <div class="grid-tres-columnas">
                <div class="campo-formulario">
                    <label asp-for="Vegetacion"></label>
                    <input asp-for="Vegetacion" placeholder="Vegetación principal" />
                    <span asp-validation-for="Vegetacion" class="text-danger"></span>
                </div>
                <div class="campo-formulario">
                    <label asp-for="UsoSuelo"></label>
                    <input asp-for="UsoSuelo" placeholder="Uso del suelo" />
                    <span asp-validation-for="UsoSuelo" class="text-danger"></span>
                </div>
                <div class="campo-formulario">
                    <label asp-for="Pendiente"></label>
                    <select asp-for="Pendiente">
                        <option value="Baja">Baja</option>
                        <option value="Media">Media</option>
                        <option value="Alta">Alta</option>
                    </select>
                    <span asp-validation-for="Pendiente" class="text-danger"></span>
                </div>
            </div>

            <div class="control-check">
                <input asp-for="TieneRecursosHidricos" type="checkbox" />
                <label asp-for="TieneRecursosHidricos">La finca posee recursos hídricos</label>
            </div>
        </div>

        <div class="fila-acciones-formulario">
            <a class="boton-secundario" asp-controller="Fincas" asp-action="MisFincas">Cancelar</a>
            <button type="submit" class="boton-primario">Guardar finca</button>
        </div>
    </form>
</section>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/registro-finca.js" asp-append-version="true"></script>
}
