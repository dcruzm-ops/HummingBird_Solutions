@model PSA.EntidadesDTO.DTOs.FincaDetalleDTO

@{
    ViewData["Title"] = "Detalle de finca";

    var latitudData = Model.Latitud;
    var longitudData = Model.Longitud;
    var cantidadEvidencias = Model.CantidadEvidencias;

    List<PSA.EntidadesDTO.DTOs.Fincas.FincaEvidenciaDTO> evidencias = new();

    if (ViewBag.EvidenciasFinca is IEnumerable<PSA.EntidadesDTO.DTOs.Fincas.FincaEvidenciaDTO> listaDto)
    {
        evidencias.AddRange(listaDto);
    }
    else if (ViewBag.EvidenciasFinca is IEnumerable<string> listaTexto)
    {
        foreach (var texto in listaTexto)
        {
            evidencias.Add(new PSA.EntidadesDTO.DTOs.Fincas.FincaEvidenciaDTO
            {
                NombreArchivo = texto,
                TipoArchivo = "No especificado",
                FechaCarga = DateTime.MinValue,
                UrlDescarga = "#"
            });
        }
    }
}

<section class="seccion-pagina">
    <div class="cabecera-pagina">
        <div>
            <span class="eyebrow">Expediente de finca</span>
            <h2>@Model.NombreFinca</h2>
            <p>Detalle general de la finca registrada en PSA Costa Rica.</p>
        </div>
    </div>

    <div class="grid-detalle-finca">
        <section class="tarjeta-panel">
            <div class="cabecera-bloque">
                <h3>Ubicación registrada</h3>
            </div>
            <p class="texto-ayuda">Punto geográfico definido para la finca según su latitud y longitud.</p>
            <div id="mapaDetalleFinca"
                 class="mapa-detalle-finca"
                 data-latitud="@latitudData"
                 data-longitud="@longitudData"
                 data-nombre-finca="@Model.NombreFinca"
                 aria-label="Mapa de ubicación de la finca">
            </div>
            <div class="grid-dos-columnas mt-3 detalle-resumen-grid">
                <div><strong>Latitud</strong><div>@Model.Latitud</div></div>
                <div><strong>Longitud</strong><div>@Model.Longitud</div></div>
            </div>
            @if (evidencias.Any())
            {
                <ul class="lista-timeline">
                    @foreach (var evidencia in evidencias)
                    {
                        <li>@evidencia</li>
                    }
                </ul>
            }
        </section>

        <section class="tarjeta-panel">
            <div class="cabecera-bloque">
                <h3>Ubicación</h3>
            </div>

            <div class="grid-dos-columnas">
                <div class="campo-detalle">
                    <span class="etiqueta">Latitud</span>
                    <strong>@latitudData</strong>
                </div>

                <div class="campo-detalle">
                    <span class="etiqueta">Longitud</span>
                    <strong>@longitudData</strong>
                </div>
            </div>
        </section>

        <section class="tarjeta-panel">
            <div class="cabecera-bloque">
                <h3>Estado del expediente</h3>
            </div>

            <div class="grid-dos-columnas">
                <div class="campo-detalle">
                    <span class="etiqueta">Cuenta bancaria</span>
                    <strong>@(Model.TieneCuentaBancaria ? "Registrada" : "Pendiente")</strong>
                </div>

                <div class="campo-detalle">
                    <span class="etiqueta">Plan de pago</span>
                    <strong>@(Model.TienePlanPago ? "Registrado" : "Pendiente")</strong>
                </div>

                <div class="campo-detalle">
                    <span class="etiqueta">Cantidad de evidencias</span>
                    <strong>@cantidadEvidencias</strong>
                </div>
            </div>
        </section>

        <section class="tarjeta-panel">
            <div class="cabecera-bloque">
                <h3>Evidencias adjuntas</h3>
            </div>

            @if (evidencias.Count > 0)
            {
                <table class="tabla-base">
                    <thead>
                        <tr>
                            <th>Archivo</th>
                            <th>Tipo</th>
                            <th>Fecha</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (PSA.EntidadesDTO.DTOs.Fincas.FincaEvidenciaDTO evidencia in evidencias)
                        {
                            <tr>
                                <td>@evidencia.NombreArchivo</td>
                                <td>@evidencia.TipoArchivo</td>
                                <td>@(evidencia.FechaCarga == DateTime.MinValue ? "N/D" : evidencia.FechaCarga.ToString("dd/MM/yyyy HH:mm"))</td>
                                <td>
                                    <a href="@evidencia.UrlDescarga" target="_blank" class="boton-secundario boton-sm">
                                        Ver
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No hay evidencias adjuntas registradas para esta finca.</p>
            }
        </section>

        <div class="fila-acciones-formulario">
            <a class="boton-secundario" asp-controller="Fincas" asp-action="MisFincas">Volver</a>
        </div>
    </div>
</section>
