@model PSA.EntidadesDTO.DTOs.FincaDetalleDTO

@{
    ViewData["Title"] = "Detalle de finca";
    var latitudData = Model.Latitud;
    var longitudData = Model.Longitud;
    var cantidadEvidencias = Model.CantidadEvidencias;
    IEnumerable<PSA.EntidadesDTO.DTOs.Fincas.FincaEvidenciaDTO> evidencias =
        (ViewBag.EvidenciasFinca as IEnumerable<PSA.EntidadesDTO.DTOs.Fincas.FincaEvidenciaDTO>)
        ?? System.Linq.Enumerable.Empty<PSA.EntidadesDTO.DTOs.Fincas.FincaEvidenciaDTO>();
}

<section class="seccion-pagina">
    <div class="cabecera-pagina">
        <div>
            <span class="eyebrow">Expediente de finca</span>
            <h2>@Model.NombreFinca</h2>
            <p>Detalle general de la finca registrada en PSA Costa Rica.</p>
        </div>
    </div>

    <div class="grid-detalle-finca">

        <!-- Información general -->
        <section class="tarjeta-panel">
            <div class="cabecera-bloque">
                <h3>Información general</h3>
            </div>

            <div class="grid-dos-columnas">
                <div class="campo-detalle">
                    <span class="etiqueta">Propietario</span>
                    <strong>@Model.PropietarioNombre</strong>
                </div>

                <div class="campo-detalle">
                    <span class="etiqueta">Estado de finca</span>
                    <strong>@Model.EstadoFinca</strong>
                </div>

                <div class="campo-detalle">
                    <span class="etiqueta">Provincia</span>
                    <strong>@Model.Provincia</strong>
                </div>

                <div class="campo-detalle">
                    <span class="etiqueta">Cantón</span>
                    <strong>@Model.Canton</strong>
                </div>

                <div class="campo-detalle">
                    <span class="etiqueta">Distrito</span>
                    <strong>@Model.Distrito</strong>
                </div>

                <div class="campo-detalle">
                    <span class="etiqueta">Hectáreas</span>
                    <strong>@Model.Hectareas</strong>
                </div>

                <div class="campo-detalle">
                    <span class="etiqueta">Vegetación</span>
                    <strong>@Model.Vegetacion</strong>
                </div>

                <div class="campo-detalle">
                    <span class="etiqueta">Uso de suelo</span>
                    <strong>@Model.UsoSuelo</strong>
                </div>

                <div class="campo-detalle">
                    <span class="etiqueta">Pendiente</span>
                    <strong>@Model.Pendiente</strong>
                </div>

                <div class="campo-detalle">
                    <span class="etiqueta">Estado de evaluación</span>
                    <strong>@Model.EstadoEvaluacion</strong>
                </div>

                <div class="campo-detalle">
                    <span class="etiqueta">Fecha de registro</span>
                    <strong>@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</strong>
                </div>

                <div class="campo-detalle">
                    <span class="etiqueta">Última actualización</span>
                    <strong>@Model.FechaActualizacion.ToString("dd/MM/yyyy HH:mm")</strong>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.DireccionExacta))
            {
                <div class="campo-detalle campo-detalle-ancho">
                    <span class="etiqueta">Dirección exacta</span>
                    <strong>@Model.DireccionExacta</strong>
                </div>
            }
        </section>

        <!-- Ubicación -->
        <section class="tarjeta-panel">
            <div class="cabecera-bloque">
                <h3>Ubicación</h3>
            </div>

            <div class="grid-dos-columnas">
                <div class="campo-detalle">
                    <span class="etiqueta">Latitud</span>
                    <strong>@latitudData</strong>
                </div>

                <div class="campo-detalle">
                    <span class="etiqueta">Longitud</span>
                    <strong>@longitudData</strong>
                </div>
            </div>
        </section>

        <!-- Estado -->
        <section class="tarjeta-panel">
            <div class="cabecera-bloque">
                <h3>Estado del expediente</h3>
            </div>

            <div class="grid-dos-columnas">
                <div class="campo-detalle">
                    <span class="etiqueta">Cuenta bancaria</span>
                    <strong>@(Model.TieneCuentaBancaria ? "Registrada" : "Pendiente")</strong>
                </div>

                <div class="campo-detalle">
                    <span class="etiqueta">Plan de pago</span>
                    <strong>@(Model.TienePlanPago ? "Registrado" : "Pendiente")</strong>
                </div>

                <div class="campo-detalle">
                    <span class="etiqueta">Cantidad de evidencias</span>
                    <strong>@cantidadEvidencias</strong>
                </div>
            </div>
        </section>

        <!-- Evidencias -->
        <section class="tarjeta-panel">
            <div class="cabecera-bloque">
                <h3>Evidencias adjuntas</h3>
            </div>

            @if (System.Linq.Enumerable.Any(evidencias))
            {
                <table class="tabla-base">
                    <thead>
                        <tr>
                            <th>Archivo</th>
                            <th>Tipo</th>
                            <th>Fecha</th>
                            <th>Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (PSA.EntidadesDTO.DTOs.Fincas.FincaEvidenciaDTO evidencia in evidencias)
                        {
                            <tr>
                                <td>@evidencia.NombreArchivo</td>
                                <td>@evidencia.TipoArchivo</td>
                                <td>@evidencia.FechaCarga.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <a href="@evidencia.UrlDescarga" target="_blank" class="boton-secundario boton-sm">
                                        Ver
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No hay evidencias registradas.</p>
            }
        </section>

        <div class="fila-acciones-formulario">
            <a class="boton-secundario" asp-action="MisFincas">Volver</a>
        </div>

    </div>
</section>