@model PSA.EntidadesDTO.DTOs.FincaDetalleDTO

@{
    ViewData["Title"] = "Detalle de finca";
    var expediente = $"PSA-{Model.FechaRegistro.Year}-{Model.IdFinca:D3}";
    var cantidadEvidencias = Model.CantidadEvidencias < 0 ? 0 : Model.CantidadEvidencias;
    var evidencias = System.Linq.Enumerable.Range(1, cantidadEvidencias).ToList();
    var latitudData = Model.Latitud.ToString(System.Globalization.CultureInfo.InvariantCulture);
    var longitudData = Model.Longitud.ToString(System.Globalization.CultureInfo.InvariantCulture);
}

<section class="seccion-pagina">
    <div class="cabecera-pagina">
        <div>
            <span class="eyebrow">Expediente de finca</span>
            <h2>@Model.NombreFinca</h2>
            <p>Detalle general de la finca registrada en PSA Costa Rica.</p>
        </div>
    </div>

    <div class="grid-detalle-finca">
        <section class="tarjeta-panel">
            <div class="cabecera-bloque">
                <h3>Ubicación registrada</h3>
            </div>

            <div class="grid-dos-columnas">
                <div class="campo-detalle"><span class="etiqueta">Propietario</span><strong>@Model.PropietarioNombre</strong></div>
                <div class="campo-detalle"><span class="etiqueta">Estado de finca</span><strong>@Model.EstadoFinca</strong></div>
                <div class="campo-detalle"><span class="etiqueta">Provincia</span><strong>@Model.Provincia</strong></div>
                <div class="campo-detalle"><span class="etiqueta">Cantón</span><strong>@Model.Canton</strong></div>
                <div class="campo-detalle"><span class="etiqueta">Distrito</span><strong>@Model.Distrito</strong></div>
                <div class="campo-detalle"><span class="etiqueta">Hectáreas</span><strong>@Model.Hectareas</strong></div>
                <div class="campo-detalle"><span class="etiqueta">Vegetación</span><strong>@Model.Vegetacion</strong></div>
                <div class="campo-detalle"><span class="etiqueta">Uso de suelo</span><strong>@Model.UsoSuelo</strong></div>
                <div class="campo-detalle"><span class="etiqueta">Pendiente</span><strong>@Model.Pendiente</strong></div>
                <div class="campo-detalle"><span class="etiqueta">Estado de evaluación</span><strong>@Model.EstadoEvaluacion</strong></div>
                <div class="campo-detalle"><span class="etiqueta">Fecha de registro</span><strong>@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</strong></div>
                <div class="campo-detalle"><span class="etiqueta">Última actualización</span><strong>@Model.FechaActualizacion.ToString("dd/MM/yyyy HH:mm")</strong></div>
            </div>
            <div class="grid-dos-columnas mt-3 detalle-resumen-grid">
                <div><strong>Latitud</strong><div>@Model.Latitud</div></div>
                <div><strong>Longitud</strong><div>@Model.Longitud</div></div>
            </div>
            @if (evidencias.Any())
            {
                <ul class="lista-timeline">
                    @foreach (var evidencia in evidencias)
                    {
                        <li>@evidencia</li>
                    }
                </ul>
            }
        </section>
    </div>

    <section class="tarjeta-panel mapa-detalle-finca-contenedor mapa-detalle-finca-contenedor--independiente">
        <div class="cabecera-bloque">
            <h3>Ubicación registrada</h3>
        </div>
        <p class="texto-ayuda">
            Punto geográfico definido para la finca según su latitud y longitud.
        </p>
        <div id="mapaDetalleFinca"
             class="mapa-detalle-finca"
             data-latitud="@latitudData"
             data-longitud="@longitudData"
             data-nombre-finca="@Model.NombreFinca"
             aria-label="Mapa de ubicación de la finca">
        </div>
    </section>

        <section class="tarjeta-panel">
            <div class="cabecera-bloque"><h3>Ubicación</h3></div>
            <div class="grid-dos-columnas">
                <div class="campo-detalle"><span class="etiqueta">Latitud</span><strong>@latitudData</strong></div>
                <div class="campo-detalle"><span class="etiqueta">Longitud</span><strong>@longitudData</strong></div>
            </div>
        </section>

        <section class="tarjeta-panel">
            <div class="cabecera-bloque"><h3>Estado del expediente</h3></div>
            <div class="grid-dos-columnas">
                <div class="campo-detalle"><span class="etiqueta">Cuenta bancaria</span><strong>@(Model.TieneCuentaBancaria ? "Registrada" : "Pendiente")</strong></div>
                <div class="campo-detalle"><span class="etiqueta">Plan de pago</span><strong>@(Model.TienePlanPago ? "Registrado" : "Pendiente")</strong></div>
                <div class="campo-detalle"><span class="etiqueta">Cantidad de evidencias</span><strong>@Model.CantidadEvidencias</strong></div>
            </div>
        </section>

        <section class="tarjeta-panel">
            <div class="cabecera-bloque"><h3>Evidencias adjuntas</h3></div>
            @{
                var evidencias = new List<PSA.EntidadesDTO.DTOs.Fincas.FincaEvidenciaDTO>();
                if (ViewBag.EvidenciasFinca is IEnumerable<PSA.EntidadesDTO.DTOs.Fincas.FincaEvidenciaDTO> listaDto)
                {
                    evidencias.AddRange(listaDto);
                }
                else if (ViewBag.EvidenciasFinca is IEnumerable<string> listaTexto)
                {
                    foreach (var texto in listaTexto)
                    {
                        evidencias.Add(new PSA.EntidadesDTO.DTOs.Fincas.FincaEvidenciaDTO
                        {
                            NombreArchivo = texto,
                            TipoArchivo = "No especificado",
                            FechaCarga = DateTime.MinValue,
                            UrlDescarga = "#"
                        });
                    }
                }
                <a class="boton-link" asp-controller="Pagos" asp-action="HistorialPagos">Ver historial de pagos</a>
            </div>
        </section>
    </div>
</section>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="~/js/detalle-finca.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <style>
        .mapa-detalle-finca-contenedor {
            display: grid;
            gap: var(--espacio-2);
        }

        .mapa-detalle-finca-contenedor--independiente {
            margin-top: var(--espacio-4);
            margin-bottom: var(--espacio-4);
        }

        .mapa-detalle-finca {
            width: 100%;
            min-height: 320px;
            border: 1px solid var(--color-borde-suave);
            border-radius: var(--radio-md);
            overflow: hidden;
            box-shadow: var(--sombra-sm);
        }
    </style>
}
