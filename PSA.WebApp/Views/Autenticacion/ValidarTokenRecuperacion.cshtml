@model PSA.EntidadesDTO.DTOs.ValidarTokenRecuperacionDTO
@{
    Layout = "~/Views/Shared/_LayoutAutenticacion.cshtml";
    ViewData["Title"] = "Validar token";
}
<div class="tarjeta-autenticacion">
    <div class="cabecera-formulario">
        <span class="eyebrow">Verificación</span>
        <h2>Ingresar token de recuperación</h2>
        <p>Digite el token de 6 dígitos enviado a su correo (vigencia máxima: 1 minuto).</p>
    </div>

    <form class="formulario-base" id="formularioValidarToken" novalidate method="post" asp-controller="Autenticacion" asp-action="ValidarTokenRecuperacion">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="campo-formulario">
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" placeholder="correo@dominio.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="campo-formulario">
            <label asp-for="Token"></label>
            <input asp-for="Token" type="text" maxlength="6" placeholder="000000" />
            <span asp-validation-for="Token" class="text-danger"></span>
        </div>

        <div class="fila-acciones-formulario">
            <button type="submit" class="boton-primario boton-bloque">Validar token</button>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
