@model List<PSA.WebApp.Models.ActividadDashboardViewModel>

@{
    ViewData["Title"] = "Notificaciones";
}

<section class="seccion-pagina">
    <div class="cabecera-pagina">
        <div>
            <span class="eyebrow">Avisos del sistema</span>
            <h2>Notificaciones</h2>
            <p>Historial reciente de actividad asociada a su cuenta y sus fincas.</p>
        </div>
        <a class="boton-secundario" asp-controller="Dashboard" asp-action="Dueno">Volver al dashboard</a>
    </div>

    <section class="tarjeta-panel">
        <ul class="lista-timeline">
            @if (Model != null && Model.Any())
            {
                @foreach (var actividad in Model)
                {
                    <li>
                        <div>
                            <strong>@actividad.Titulo</strong><br />
                            <small>@actividad.Fecha.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                    </li>
                }
            }
            else
            {
                <li>
                    <span>No hay notificaciones para mostrar.</span>
                </li>
            }
        </ul>
    </section>
</section>