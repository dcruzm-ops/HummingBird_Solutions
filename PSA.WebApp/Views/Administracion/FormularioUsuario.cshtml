@model PSA.WebApp.Models.FormularioUsuarioAdminViewModel
@{
    ViewData["Title"] = Model.EsEdicion ? "Editar usuario" : "Crear usuario";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">@ViewData["Title"]</h2>
            <small class="text-muted">Gestione usuarios del sistema y sus roles.</small>
        </div>
        <a asp-action="GestionUsuarios" class="btn btn-outline-secondary">Volver</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="@(Model.EsEdicion ? "EditarUsuario" : "CrearUsuario")" method="post" novalidate>
                @if (Model.EsEdicion)
                {
                    <input type="hidden" asp-for="Usuario.IdUsuario" />
                }

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Usuario.NombreCompleto" class="form-label"></label>
                        <input asp-for="Usuario.NombreCompleto" class="form-control" />
                        <span asp-validation-for="Usuario.NombreCompleto" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Usuario.Email" class="form-label"></label>
                        <input asp-for="Usuario.Email" class="form-control" />
                        <span asp-validation-for="Usuario.Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Usuario.IdRol" class="form-label">Rol</label>
                        <select asp-for="Usuario.IdRol" class="form-select" asp-items="@(new SelectList(Model.Roles, "Id", "Nombre"))">
                            <option value="">Seleccione...</option>
                        </select>
                        <span asp-validation-for="Usuario.IdRol" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Usuario.Estado" class="form-label"></label>
                        <select asp-for="Usuario.Estado" class="form-select">
                            <option value="Activo">Activo</option>
                            <option value="Inactivo">Inactivo</option>
                        </select>
                        <span asp-validation-for="Usuario.Estado" class="text-danger"></span>
                    </div>
                    <div class="col-md-4"></div>
                    <div class="col-md-6">
                        <label asp-for="Usuario.Contrasena" class="form-label">Contraseña</label>
                        <input asp-for="Usuario.Contrasena" class="form-control" type="password" autocomplete="new-password" />
                        <span asp-validation-for="Usuario.Contrasena" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Usuario.ConfirmacionContrasena" class="form-label">Confirmación de contraseña</label>
                        <input asp-for="Usuario.ConfirmacionContrasena" class="form-control" type="password" autocomplete="new-password" />
                        <span asp-validation-for="Usuario.ConfirmacionContrasena" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="GestionUsuarios" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
