@model PSA.WebApp.Models.RolesPermisosViewModel
@{
    ViewData["Title"] = "Roles y permisos";
}

<div class="container-fluid py-3">
    @if (TempData["Exito"] is string mensajeExito && !string.IsNullOrWhiteSpace(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show" role="status">
            @mensajeExito
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["Error"] is string mensajeError && !string.IsNullOrWhiteSpace(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @mensajeError
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">Configuración de roles y permisos</h2>
            <small class="text-muted">Asigne permisos funcionales a cada rol del sistema.</small>
        </div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrearRol">Crear rol</button>
    </div>

    @if (Model.Roles.Count == 0)
    {
        <div class="alert alert-warning">No hay roles disponibles para configurar.</div>
    }

    @if (Model.PermisosDisponibles.Count == 0)
    {
        <div class="alert alert-info">No hay permisos registrados en el catálogo. Ejecuta el script de base de datos de administración para cargar permisos.</div>
    }

    @for (var i = 0; i < Model.Roles.Count; i++)
    {
        var rol = Model.Roles[i];
        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <strong>@rol.NombreRol</strong>
                    <div class="text-muted small">@rol.DescripcionRol</div>
                </div>
                <span class="badge bg-@(rol.Activo ? "success" : "secondary")">@(rol.Activo ? "Activo" : "Inactivo")</span>
            </div>
            <div class="card-body">
                <form asp-action="GuardarPermisosRol" method="post">
                    <input type="hidden" name="IdRol" value="@rol.IdRol" />

                    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
                        @foreach (var permiso in Model.PermisosDisponibles)
                        {
                            var checkedPermiso = rol.CodigosPermisoAsignados.Contains(permiso.Codigo);
                            var controlId = $"permiso_{rol.IdRol}_{permiso.IdPermiso}";
                            <div class="col">
                                <div class="form-check border rounded p-3 h-100">
                                    <input class="form-check-input" type="checkbox" name="CodigosPermiso" value="@permiso.Codigo" checked="@(checkedPermiso ? "checked" : null)" id="@controlId" />
                                    <label class="form-check-label ms-1" for="@controlId">
                                        <strong>@permiso.Nombre</strong><br />
                                        <span class="text-muted small">@permiso.Descripcion</span>
                                    </label>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-end mt-3">
                        <button type="submit" class="btn btn-primary">Guardar permisos</button>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="modalCrearRol" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CrearRol" method="post" id="formCrearRol">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Crear nuevo rol</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="NuevoRol.Nombre" class="form-label"></label>
                        <input asp-for="NuevoRol.Nombre" class="form-control" />
                        <span asp-validation-for="NuevoRol.Nombre" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NuevoRol.Descripcion" class="form-label"></label>
                        <textarea asp-for="NuevoRol.Descripcion" class="form-control"></textarea>
                    </div>
                    <div class="form-check">
                        <input asp-for="NuevoRol.Activo" class="form-check-input" />
                        <label asp-for="NuevoRol.Activo" class="form-check-label">Rol activo</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary" id="btnCrearRol">
                        <span class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true" id="spinnerCrearRol"></span>
                        <span id="textoBtnCrearRol">Crear rol</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const formCrearRol = document.getElementById('formCrearRol');
            const btnCrearRol = document.getElementById('btnCrearRol');
            const spinnerCrearRol = document.getElementById('spinnerCrearRol');
            const textoBtnCrearRol = document.getElementById('textoBtnCrearRol');

            if (!formCrearRol || !btnCrearRol || !spinnerCrearRol || !textoBtnCrearRol) return;

            formCrearRol.addEventListener('submit', function () {
                btnCrearRol.disabled = true;
                spinnerCrearRol.classList.remove('d-none');
                textoBtnCrearRol.textContent = 'Guardando...';
            });
        })();
    </script>
}
