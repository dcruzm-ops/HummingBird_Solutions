@model PSA.EntidadesDTO.DTOs.Pagos.AdminPaymentPlanDetailDto
@{ ViewData["Title"] = "Detalle del plan"; var c = Model.Calculo; }
<section class="seccion-pagina">
<div class="cabecera-pagina"><div><span class="eyebrow">Plan #@Model.Plan.IdPlanPago</span><h2>@Model.Plan.NombreFinca (@Model.Plan.Anio)</h2></div><a class="boton-secundario" asp-action="PlanesPago">Volver</a></div>
<section class="tarjeta-panel"><h3>Sección 1 — Datos base</h3><ul class="lista-timeline"><li>Finca: @Model.Plan.NombreFinca</li><li>Propietario: @Model.Plan.Propietario</li><li>Estado plan: @Model.Plan.EstadoPlan</li><li>Ingeniero: @Model.Plan.Ingeniero</li><li>Estado bancario: @Model.Plan.EstadoBancario (@(Model.Plan.CuentaBancariaMascara ?? "Sin cuenta"))</li></ul></section>
<section class="tarjeta-panel"><h3>Sección 2 — Datos aplicados</h3><ul class="lista-timeline"><li>Hectáreas aprobadas: @c.HectareasAprobadas.ToString("N2")</li><li>Vegetación final: @c.VegetacionFinal</li><li>Ríos/quebradas: @(c.TieneRiosOQuebradasFinal?"Sí":"No")</li><li>Nacientes: @c.CantidadNacientesFinal</li><li>Pendiente final: @c.PendienteFinal</li><li>Precio base por hectárea: ₡@c.PrecioBasePorHectarea.ToString("N2")</li></ul></section>
<section class="tarjeta-panel"><h3>Sección 3 — Desglose técnico</h3><ul class="lista-timeline"><li>Base: ₡@c.MontoBaseMensual.ToString("N2")</li><li>Vegetación (@c.PorcentajeVegetacion.ToString("N2")%): ₡@c.MontoAjusteVegetacion.ToString("N2")</li><li>Ríos/quebradas (@c.PorcentajeRiosQuebradas.ToString("N2")%): ₡@c.MontoAjusteRiosQuebradas.ToString("N2")</li><li>Nacientes (@c.CantidadNacientesFinal × 5% = @c.PorcentajeNacientes.ToString("N2")%): ₡@c.MontoAjusteNacientes.ToString("N2")</li><li>Pendiente (@c.PorcentajePendiente.ToString("N2")%): ₡@c.MontoAjustePendiente.ToString("N2")</li><li>Porcentaje bruto: @c.PorcentajeTotalAntesTope.ToString("N2")%</li><li>Tope: @c.PorcentajeTopeAplicado.ToString("N2")%</li><li>Aplicado: @c.PorcentajeTotalAplicado.ToString("N2")%</li><li><strong>Total mensual: ₡@c.MontoFinalMensual.ToString("N2")</strong></li></ul></section>
<section class="tarjeta-panel"><h3>Sección 4 — Trazabilidad</h3><ul class="lista-timeline"><li>Vegetación original/final: @c.VegetacionOriginal / @c.VegetacionFinal</li><li>Ríos original/final: @(c.TieneRiosOQuebradasOriginal?"Sí":"No") / @(c.TieneRiosOQuebradasFinal?"Sí":"No")</li><li>Nacientes original/final: @c.CantidadNacientesOriginal / @c.CantidadNacientesFinal</li><li>Pendiente original/final: @c.PendienteOriginal / @c.PendienteFinal</li></ul></section>
</section>
