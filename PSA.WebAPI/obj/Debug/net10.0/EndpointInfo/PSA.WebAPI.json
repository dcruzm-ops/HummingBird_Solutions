  "components": {
    "schemas": {
      "ActividadAuditoriaDTO": {
        "type": "object",
        "properties": {
          "modulo": {
            "type": "string",
            "nullable": true
          },
          "accion": {
            "type": "string",
            "nullable": true
          },
          "detalle": {
            "type": "string",
            "nullable": true
          },
          "fechaAccion": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "AsignarEvaluacionDTO": {
        "type": "object",
        "properties": {
          "idIngeniero": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "InicioSesionDTO": {
        "required": [
          "contrasena",
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "contrasena": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RecuperarContrasenaDTO": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "correo": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "RegistrarFincaDTO": {
        "required": [
          "canton",
          "distrito",
          "hectareas",
          "latitud",
          "longitud",
          "nombreFinca",
          "pendiente",
          "provincia",
          "usoSuelo",
          "vegetacion"
        ],
        "type": "object",
        "properties": {
          "idPropietario": {
            "type": "integer",
            "format": "int32"
          },
          "nombreFinca": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "provincia": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "canton": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "distrito": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "direccionExacta": {
            "maxLength": 250,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "latitud": {
            "maximum": 90,
            "minimum": -90,
            "type": "number",
            "format": "double"
          },
          "longitud": {
            "maximum": 180,
            "minimum": -180,
            "type": "number",
            "format": "double"
          },
          "hectareas": {
            "maximum": 100000,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "vegetacion": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "tieneRecursosHidricos": {
            "type": "boolean"
          },
          "tieneRiosOQuebradas": {
            "type": "boolean"
          },
